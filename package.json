{
  "name": "polymarket-market-maker-bot",
  "version": "1.0.0",
  "description": "Professional-grade Polymarket market making bot with real feeds, realistic dry-run, inventory/risk controls, auto-healing, and full observability.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "polymarket",
    "market-maker",
    "crypto",
    "hft",
    "prediction-markets",
    "avellaneda-stoikov"
  ],
  "license": "MIT",
  "dependencies": {
    "@polymarket/clob-client": "^4.21.0",
    "dotenv": "^16.4.5",
    "eventemitter3": "^5.0.1",
    "ethers": "^5.7.2",
    "express": "^4.19.2",
    "uuid": "^9.0.1",
    "ws": "^8.17.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.5.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
