# =============================================================================
# POLYMARKET MARKET MAKER BOT — ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and customize values.
# All values have safe defaults — only override what you need.
# Parameters marked [POL-2] are from the research spec and validated on startup.
# =============================================================================

# --- Mode & Data Source ---
MODE=dry_run                  # dry_run | paper | live
DATA_SOURCE=real              # real | sim
LIVE_API_ENABLED=false        # Safety flag: must be true for MODE=live

# --- Bankroll & Sizing ---
BANKROLL_USDC=500
MIN_ORDER_SIZE_USDC=5
MAX_ORDER_SIZE_USDC=50
DEFAULT_QUOTE_SIZE_USDC=15

# --- Target Assets & Intervals ---
TARGET_ASSETS=BTC,ETH,SOL,DOGE,XRP,BNB,HYPE
TARGET_INTERVALS=5m,15m

# =============================================================================
# POL-2 RESEARCH SPEC PARAMETERS (17 tunables)
# These control quoting, inventory, discovery, freshness, and risk.
# All are range-validated on startup. Kill thresholds noted below.
# =============================================================================

# --- QUOTING [POL-2] (4 params) ---
# Base half-spread in BPS. Acts as a floor under the AS spread.
# Kill threshold: <50 = invisible, >400 = no fills.
QUOTE_BASE_HALF_SPREAD_BPS=150       # range: 50-400

# Inventory skew multiplier. Higher = more aggressive inventory reduction.
# Kill threshold: >5.0 = pulls quotes too aggressively on skew.
QUOTE_SKEW_FACTOR=2.0                # range: 1.0-5.0

# Time-to-resolve weight in discovery scoring.
# Higher = prefer markets with more time remaining.
QUOTE_TTR_WEIGHT=1.0                 # range: 0.5-2.0

# Regime transition sensitivity. Higher = faster regime switching.
# Kill threshold: >2.0 = regime thrashing, <0.5 = regime lag.
QUOTE_REGIME_SENSITIVITY=1.0         # range: 0.5-2.0

# --- INVENTORY [POL-2] (2 params) ---
# Maximum shares per token before emergency unwind logic triggers.
# Kill threshold: >5000 = excessive capital at risk.
INVENTORY_MAX_SHARES=1000            # range: 500-5000

# Emergency threshold as % of INVENTORY_MAX_SHARES.
# At 80% of max shares, bot enters emergency sizing reduction.
INVENTORY_EMERGENCY_THRESHOLD_PCT=80 # range: 60-95

# --- MARKET SELECTION [POL-2] (4 params) ---
# Minimum 24h volume (USDC) for a market to score above baseline. Note:
# enforcement is soft (scoring penalty), not a hard reject, so freshly-opened
# rolling windows with low early volume are still tradable.
DISCOVERY_MIN_VOLUME_USDC=1000       # range: 100-50000

# Maximum initial spread (BPS) for a new market. Wider = skip.
DISCOVERY_MAX_INITIAL_SPREAD_BPS=200 # range: 100-500

# Minimum time-to-resolve (hours) — ONLY applied to non-rolling markets
# (intervals > 1h). Rolling 5m/15m/1h windows instead require >= prewarm_secs
# of life remaining; the hours-based floor would reject every one.
DISCOVERY_MIN_TTR_HOURS=1            # range: 0-168

# Maximum time-to-resolve (days). Markets expiring later are filtered out.
DISCOVERY_MAX_TTR_DAYS=30            # range: 7-365

# --- FRESHNESS / DATA QUALITY [POL-2] (3 params) ---
# Max staleness (ms) for Polymarket order book before marking feed stale.
# Kill threshold: <1000 = too sensitive, >15000 = stale data risk.
FRESHNESS_POLY_MAX_STALE_MS=5000     # range: 1000-15000

# Max staleness (ms) for Binance feed before marking stale.
FRESHNESS_BINANCE_MAX_STALE_MS=15000 # range: 5000-60000

# Minimum order book depth (levels per side) for health checks.
FRESHNESS_MIN_ORDERBOOK_DEPTH=3      # range: 1-10

# --- RISK CONTROL [POL-2] (4 params) ---
# Binance velocity (BPS/sec) that triggers pre-emptive cancel.
RISK_CANCEL_VELOCITY_BPS_TRIGGER=12  # range: 5-30

# Binance aggressor ratio threshold for pre-emptive cancel.
RISK_CANCEL_AGGRESSOR_THRESHOLD=0.55 # range: 0.4-0.7

# Freeze duration (ms) after a pre-emptive cancel trigger.
RISK_CANCEL_FREEZE_MS=1200           # range: 500-5000

# Main control loop tick interval (ms).
# Kill threshold: <100 = CPU thrash, >5000 = slow reaction.
CONTROL_TICK_MS=500                  # range: 100-5000

# --- POL-35 additions ---
# Live fill detector polling interval (ms).
FILL_DETECTOR_POLL_MS=3000
# Minimum pair edge in bps required for BUY YES + BUY NO paired placement.
# (YES price + NO price must sum to <= 1 - MIN_PAIR_EDGE_BPS/10000.)
# Example: 200 means prices must sum to <= 0.98 (2c edge per pair).
MIN_PAIR_EDGE_BPS=200
# Exchange tick size for price rounding (Polymarket binary markets = 0.01).
TICK_SIZE=0.01

# =============================================================================
# LEGACY / ADVANCED PARAMETERS
# =============================================================================

# --- Discovery ---
DISCOVERY_POLL_MS=30000
DISCOVERY_MIN_LIQUIDITY_SCORE=0.15
DISCOVERY_PREWARM_SECS=60

# --- Polymarket Feed ---
POLYMARKET_HTTP=https://clob.polymarket.com
POLYMARKET_WS=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYMARKET_GAMMA=https://gamma-api.polymarket.com
POLY_RECONNECT_MIN_MS=1000
POLY_RECONNECT_MAX_MS=30000

# --- Binance Feed ---
BINANCE_WS=wss://stream.binance.com:9443/stream
BINANCE_ENABLED=true
BINANCE_SYMBOL_MAP=BTC:BTCUSDT,ETH:ETHUSDT,SOL:SOLUSDT,DOGE:DOGEUSDT,XRP:XRPUSDT,BNB:BNBUSDT,HYPE:HYPEUSDT

# --- Avellaneda-Stoikov ---
AV_GAMMA=0.8
AV_K=1.5
AV_SIGMA_FLOOR=0.004
AV_SPREAD_MIN_BPS=40
AV_SPREAD_MAX_BPS=400
AV_MIN_EDGE_BPS=18

# --- Fair Value Weights ---
W_MICROPRICE=0.45
W_POLY_IMBALANCE=0.15
W_BINANCE_IMBALANCE=0.2
W_BINANCE_AGGRESSOR=0.1
W_BINANCE_MOMENTUM=0.1

# --- Paper Trading ---
PAPER_FILL_PROB_BASE=0.22
PAPER_PARTIAL_FILL_PROB=0.3
PAPER_MAKER_FEE_BPS=0
PAPER_TAKER_FEE_BPS=20
PAPER_LATENCY_MS=140
PAPER_TOXICITY_BASELINE=0.18
PAPER_SLIPPAGE_BPS=4

# --- Risk ---
RISK_SESSION_LOSS_CAP_USDC=100
RISK_DRAWDOWN_CAP_USDC=60
RISK_CONSECUTIVE_LOSS_CAP=6
RISK_API_ERROR_CAP=25
RISK_TOXIC_FLOW_EMA_CAP=0.55
RISK_MAX_INVENTORY_USDC=200

# --- Adverse Selection ---
ADV_SAMPLE_1S_MS=1000
ADV_SAMPLE_5S_MS=5000
ADV_EMA_ALPHA=0.08

# --- Auto-Healing ---
AUTOHEAL_INTERVAL_MS=180000
AUTOHEAL_MIN_FILLS=8
AUTOHEAL_SPREAD_STEP_BPS=5
AUTOHEAL_SIZE_STEP=0.1

# --- Order Management ---
ORDER_MAX_AGE_MS=15000
ORDER_REPLACE_DRIFT_BPS=18
ORDER_POST_ONLY=true
RATE_LIMIT_ORDERS_PER_SEC=4
RATE_LIMIT_BURST=8

# --- Polymarket Credentials (live mode only) ---
# NEVER commit real keys. Use .env.local or secrets manager.
POLY_PRIVATE_KEY=
POLY_FUNDER_ADDRESS=
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=
POLY_CHAIN_ID=137

# --- Dashboard ---
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787

# --- Logging ---
LOG_LEVEL=info

# --- Alerts ---
# Discord webhook for real-time alerts (kill thresholds, risk state changes, start/stop)
# Create at: Discord > Server Settings > Integrations > Webhooks > New Webhook > Copy URL
# Leave empty to disable Discord alerts
DISCORD_WEBHOOK_URL=
